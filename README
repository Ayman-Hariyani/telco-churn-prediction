def clipDuration(x):
    if x['FINAL_OUTLIER']=='LV1' or x['FINAL_OUTLIER']=='LV1G':
        val = x['MADOUTLIER_LV1']
    elif x['FINAL_OUTLIER']=='LV2' or x['FINAL_OUTLIER']=='LV2G':
        val = x['MADOUTLIER_LV2']
    elif x['FINAL_OUTLIER']=='LV3' or x['FINAL_OUTLIER']=='LV3G':
        val = x['MADOUTLIER_LV3']

    if x.name%10000==0:
        print(x.name)
    return min(val, x['DURATION'])

def readChannelConfig(dir):
    for dir in glob.glob(dir+'*', recursive=True):
        if re.search("Final List", dir):
            channelGenre = pd.read_excel(dir, sheet_name='Channel Update')
            channelGenre.columns = [col.strip() for col in channelGenre.columns]
            channelGenre['Language'] = channelGenre['Language'].str.strip()
            channelGenre.loc[channelGenre['Genre'] == 'Movie', 'Genre'] = 'Movies'
            print(dir)
    hindiCondition = ((channelGenre['Language'].apply(lambda x:re.search("Hindi", str(x))!=None)) &
                     (channelGenre['Genre'].apply(lambda x:re.search("Movies|Kids|Sports|GEC", str(x))!=None)))
    englishCondition = ((channelGenre['Language'].apply(lambda x:re.search("English", str(x))!=None)) &
                     (channelGenre['Genre'].apply(lambda x:re.search("Kids|Sports", str(x))!=None)))
    exemptChannels = channelGenre[hindiCondition | englishCondition]['Channel Codes']
    return channelGenre, exemptChannels
