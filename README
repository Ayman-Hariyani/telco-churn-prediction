def detailed_nccs_map(x):
    if x in ['A2', 'B1', 'A1', 'B2', 'A3']:
        return 1
    else:
        return 2

def town_class_map(x):
    if x in ['1 - 10L', 'Below 1L', 'Rural']:
        return 1
    elif x in ['10 - 75 L']:
        return 2
    elif x in ['Mega City']:
        return 3
    else:
        return 99

