📉 Customer Churn Prediction 📊

📌 Overview
The Telco Customer Churn dataset contains information about customers of a telecom company, including
their demographics, services subscribed, account details, and billing information.

The goal of this project is to predict whether a customer will churn (leave the service) or not, enabling
businesses to take proactive retention measures.

📊 Dataset
Source: Kaggle Telco Customer Churn Dataset
Total Records: 7043 customers

Features include:
Customer demographics (gender, senior citizen, etc.)
Service details (internet service, phone service, etc.)
Account information (tenure, contract type)
Billing details (monthly charges, total charges)

⚙️ Approach
🔹 Data Cleaning:
Handled missing values in TotalCharges
Converted data types where required
Encoded categorical variables into numerical format
🔹 Exploratory Data Analysis:
Analyzed churn patterns based on:
Tenure
Monthly Charges
Contract Type
Identified key trends and relationships influencing churn
🔹 Feature Selection:
Selected relevant features impacting churn behavior
Removed unnecessary or redundant columns
🔹 Models Used:
Logistic Regression
Random Forest

📈 Results
Logistic Regression Accuracy: 77.8%
Random Forest Accuracy: 75.7%
Logistic Regression performed better overall in terms of accuracy and produced fewer false positives.
Random Forest slightly improved detection of churn cases (true positives).

🔍 Key Insights
Customers with low tenure are more likely to churn
Customers with higher monthly charges show higher churn rates
Long-term customers tend to stay due to loyalty and switching costs
High-risk segment identified: low tenure + high monthly charges

🚀 Future Improvements
Apply feature scaling for better model performance
Handle class imbalance using techniques like class weights or resampling
Use advanced evaluation metrics (Precision, Recall, F1-score, ROC-AUC)
Implement cross-validation for robust evaluation

🛠️ Tech Stack
Python
Pandas, NumPy
Matplotlib, Seaborn
Scikit-learn

🎯 Conclusion

This project demonstrates how machine learning can be used to identify customers at risk of churn. By
leveraging key features such as tenure and monthly charges, businesses can design targeted retention
strategies to reduce customer loss and improve long-term profitability.



import numpy as np
import pandas as pd
import glob
import re
from kmodes.kmodes import KModes
from multiprocessing import Pool, cpu_count
import functools

def processUser(ind, channel, statementFile):
    if ind[0]%100==0:
        print(ind)
    consideredData = statementFile[(statementFile['CHANNEL'].values==channel) & (statementFile['KEY'].values==ind[1])][['KEY', 'START', 'END', 'DURATION']]
    flagList = list(np.repeat("no session", len(consideredData)))

    for row in range(0, len(consideredData) - 1):
        if consideredData.iloc[row, 2] == consideredData.iloc[row + 1, 1]:
            if flagList[row - 1] == "session "+str(row-1):
                flagList[row] = "session "+str(row-1)
                flagList[row + 1] = "session "+str(row-1)
            else:
                flagList[row] = "session " + str(row)
                flagList[row + 1] = "session " + str(row)
    #statementFile.loc[statementFile.index.isin(consideredData.index), 'CONSECUTIVE'] = flagList

    return pd.DataFrame({'index':consideredData.index, 'flag':flagList})

def makeDurList(historyDataConsidered):
    if len(historyDataConsidered)<12:
        return list(historyDataConsidered) + list(np.repeat(0, 12 - len(historyDataConsidered)))
    else:
        return list(historyDataConsidered)

def getDurComp(ind, consideredDataChannel, historyDataChannel):
    consideredDataInd = consideredDataChannel[consideredDataChannel['KEY'].isin([ind[1]])]
    historyDataConsidered = historyDataChannel[historyDataChannel['KEY'].isin([ind[1]])]
    durList = {'durList':[], 'index':[]}
    for part in list(consideredDataInd['DAYPART']):
        data = historyDataConsidered[historyDataConsidered['DAYPART'].isin([part])]['DURATION'].tolist()
        data.extend(list(np.repeat(0, max(0, 12 - len(data)))))
        durList['durList'].append(data)
    durList['index'] = list(consideredDataInd.index)

    return pd.DataFrame(durList)

def getDurCompGenre(ind, consideredDataGenre, historyDataGenre):
    consideredDataInd = consideredDataGenre[consideredDataGenre['KEY'].isin([ind[1]])]
    historyDataConsidered = historyDataGenre[historyDataGenre['KEY'].isin([ind[1]])]

    durList = {'durList':[], 'index':[]}
    for part in list(consideredDataInd['DAYPART']):
        durList['durList'].append(makeDurList(historyDataConsidered[historyDataConsidered['DAYPART'].isin([part])]['DURATION']))
    durList['index'] = list(consideredDataInd.index)

    return pd.DataFrame(durList)

def checkDayPartsPresent(start, end, dayPartsDict):
    dayParts = {'name':[], 'from':[], 'to':[], 'dp':[]}
    for part in list(dayPartsDict.values()):
        if start >= part['from'] and start <= part['to']:
            if end >= part['from'] and end <= part['to']:
                dayParts['name'].append(part['name'])
                dayParts['dp'].append(part['part'])
                dayParts['from'].append(start)
                dayParts['to'].append(end)
            else:
                dayParts['name'].append(part['name'])
                dayParts['dp'].append(part['part'])
                dayParts['from'].append(start)
                dayParts['to'].append(part['to'])
        elif end >= part['from'] and end <= part['to']:
            dayParts['name'].append(part['name'])
            dayParts['dp'].append(part['part'])
            dayParts['from'].append(part['from'])
            dayParts['to'].append(end)
        elif (part['from'] >= start and part['from'] <= end):
            if (part['to'] >= start and part['to'] <= end):
                dayParts['name'].append(part['name'])
                dayParts['dp'].append(part['part'])
                dayParts['from'].append(part['from'])
                dayParts['to'].append(part['to'])
            else:
                dayParts['name'].append(part['name'])
                dayParts['dp'].append(part['part'])
                dayParts['from'].append(part['from'])
                dayParts['to'].append(end)
    return dayParts

def calcOutlierMAD(durList, channel, bval, tamperedChannels):
    try:
        durList = np.array(durList).astype(np.float)
    except:
        durList = np.array(durList[0]).astype(np.float)

    if (channel not in tamperedChannels) and (np.sum(durList)==0):
        return "PASS"
    else:
        median = np.median(durList)
        absMedian = np.median(np.abs(durList - median))
        mad = median + ((1.483 * absMedian) * bval)
        mad = np.round(mad/60, decimals=0) * 60
        return min(max(mad, 0), 1800)

def processSplitMAD(data, tamperedChannels):
    mads = data[['DURATIONLIST', 'CHANNEL', 'BVAL']].apply(lambda x: calcOutlierMAD(x['DURATIONLIST'], x['CHANNEL'], x['BVAL'], tamperedChannels), axis=1)
    return pd.DataFrame({"index":data.index, "mad":mads})

def parallelizeMADCalc(df, splits, tamperedConfig):
    df_split = np.array_split(df, splits)
    pool = Pool(cpu_count() - 3)
    df = pd.concat(pool.map(functools.partial(processSplitMAD, tamperedChannels=tamperedConfig), df_split))
    pool.close()
    pool.join()
    return df

def calcOutlierMADVer2(durList, bval):
    try:
        durList = np.array(durList).astype(np.float)
    except:
        durList = np.array(durList[0]).astype(np.float)

    if np.sum(durList)==0:
        return "PASS"
    else:
        median = np.median(durList)
        absMedian = np.median(np.abs(durList - median))
        mad = median + ((1.483 * absMedian) * bval)
        mad = np.round(mad / 60, decimals=0) * 60
        #print(mad, durList, median, bval)
        return min(max(mad, 0), 1800)

def prev12Dates(reqDate):
    dates = []
    reqDate = pd.to_datetime(reqDate)
    day = 'W-'+reqDate.strftime('%A')[:3]
    allDates = pd.date_range(start='2019', end=reqDate, freq=day).tolist()
    for date in allDates:
        if date < reqDate:
            dates.append(date.strftime('%Y%m%d'))
    return dates[len(dates)-12:]

def prev12DData(dayPartsDict, cdate):
    historyData = pd.DataFrame()
    path = "\\\\10.10.2.51\\Released_Data\\R0\\**\\*_statement.csv"
    dirList = []
    print(prev12Dates(cdate))
    for dir in glob.glob(path, recursive=True):
        if (re.search("_og|-og|Run|--|_org|old|Old|D3|Master_statement|\\\W46\20191109\20191109_statement\20191109_statement.csv", dir)==None) & (len(dir.split("\\"))<=9):
            for date in prev12Dates(cdate):
                if re.search(date, dir):
                    if dir.split("\\")[6] in ["W" + str(week) for week in range(40, 49)]:
                        dirList.append(dir.replace("R0", "R0_Unmasked Data"))
                    else:
                        dirList.append(dir)
    print(len(dirList))
    p = Pool(cpu_count()-3)
    historyData = historyData.append(p.map(functools.partial(historyDataProcess, dayPartsDict=dayPartsDict), dirList))
    p.close()
    p.join()
    return historyData

def historyDataProcess(dir, dayPartsDict):
    data = pd.read_csv(dir)
    print(dir)
    data['DATE'] = np.repeat(dir.split("\\")[7], len(data))
    data['END'] = data['START'] + data['DURATION']
    data['KEY'] = data['HOUSEHOLD'].astype(str) + " " + data['INDIVIDUAL'].astype(str)

    dayParts = {'name': [], 'from': [], 'to': []}
    numOfDayParts = []
    for start, end in zip(list(data['START']), list(data['END'])):
        tempDf = checkDayPartsPresent(start, end, dayPartsDict)
        dayParts['name'].extend(tempDf['name'])
        dayParts['from'].extend(tempDf['from'])
        dayParts['to'].extend(tempDf['to'])
        numOfDayParts.append(len(tempDf['name']))

    data = data.loc[data.index.repeat(pd.Series(numOfDayParts))]
    data['DAYPART'] = dayParts['name']
    data['START'] = dayParts['from']
    data['END'] = dayParts['to']
    data['DURATION'] = data['END'] - data['START']

    data = data.groupby(by=['DATE', 'CHANNEL', 'KEY', 'DAYPART'])['DURATION'].sum().reset_index()
    return data

